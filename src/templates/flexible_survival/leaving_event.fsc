// title: Stop the player when leaving
// about: Interrupts the player on the way out of a place.
// kind: event
// question: name|Name|name|
// question: place|Leaving which place?|location|
// question: opening|What interrupts the player?|prose|Someone calls you back.
// question: direction|Leaving direction|choice:north,east,south,west,northeast,northwest,southeast,southwest,up,down,inside,outside|north
== event {{id}}
name: {{name}}
found by: leaving {{place}} {{direction}}
repeat: always
play:
    {{opening}}
    * Keep walking
        ~ continue moving
        -> end
    * Stay here
        -> end
