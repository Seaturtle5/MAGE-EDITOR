// title: A companion
// about: Someone who can join the party and follow along.
// kind: character
// question: name|Name|name|
// question: place|Home place|location|
// question: greeting|Greeting|prose|I can join you.
== character {{id}}
name: {{name}}
pronouns: they
lives at: {{place}}
companion:
    hit bonus: 0
talk:
    {{greeting}}
    * Come with me
        ~ companion + {{id}}
        -> end
